# Public identifiers baked into Exarch engine releases. None of these are
# secrets: the Clerk publishable key and CLI client id are designed to ship in
# clients, and the relay and hosted-app origins are public addresses. The
# release workflow copies this file to .env before building. Keep it in step
# with the Exarch desktop's connect allowlist and the phone app's config.
#
# Production Clerk instance for exarch.run.
T3CODE_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsuZXhhcmNoLnJ1biQ
T3CODE_CLERK_JWT_TEMPLATE=exarch-relay
T3CODE_CLERK_CLI_OAUTH_CLIENT_ID=NRLBG5a636ETgy6G

# The Exarch relay, deployed from infra/relay.
T3CODE_RELAY_URL=https://relay.exarch.run

# Exarch has no hosted web app. The CLI's browser sign-in would print this
# origin; the Exarch desktop uses the device-code flow instead, which never
# touches it. It is set so that no T3 address is ever printed.
T3CODE_HOSTED_APP_URL=https://app.exarch.run
