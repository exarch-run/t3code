{
  "about": "Shared accept and reject cases for AI response reports. An identical copy lives in Exarch at apps/mobile/test/fixtures/report-contract.json. `excerptRepeat` and `notesRepeat` replace that field with the letter a repeated that many times.",
  "cases": [
    {
      "name": "excerpt only",
      "accepted": true,
      "body": {
        "id": "0b9f8c62-3f5e-4a4b-9d7e-2c1a5f6e7d80",
        "reason": "Harmful content",
        "excerpt": "The answer said to do something dangerous.",
        "notes": ""
      }
    },
    {
      "name": "notes only",
      "accepted": true,
      "body": {
